<UserControl x:Class="ClawBY19.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClawBY19.ViewModels"
             xmlns:helpers="clr-namespace:ClawBY19.Converters"
             Background="{DynamicResource BgDarkBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 标题 + 保存 -->
            <RowDefinition Height="*"/>     <!-- 内容 -->
        </Grid.RowDefinitions>

        <!-- ── 标题栏 ── -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                Padding="16,10" BorderBrush="{DynamicResource BgCardBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚙️ 设置" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource AccentGreenBrush}"
                           FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Grid.Column="2" Content="💾 保存设置" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveSettingsCommand}"/>
            </Grid>
        </Border>

        <!-- ── 主体：左右分栏 ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="320"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════ 左侧：模型 ListBox ══════ -->
            <Border Grid.Column="0" Background="{DynamicResource BgPanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,10" BorderBrush="{DynamicResource BgCardBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="选择模型" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ModelItems}"
                             SelectedItem="{Binding SelectedModelItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background"
                                                            Value="{DynamicResource BgCardBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background"
                                                            Value="{DynamicResource BgCardBrush}"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource AccentBlueBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ModelSettingItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding FullName}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}">
                                        </TextBlock>
                                        <TextBlock Text="{Binding Category}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <!-- 可用状态指示 -->
                                    <Ellipse Grid.Column="1" Width="7" Height="7"
                                             VerticalAlignment="Center" Margin="4,0,0,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource AccentGreenBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BgCardBrush}" Cursor="SizeWE"/>

            <!-- ══════ 右侧：模型参数面板 + 其他设置 ══════ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,20,16">

                    <!-- ── 选中模型参数面板 ── -->
                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- 模型标题 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="🤖" FontSize="18" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PanelModelName}" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding PanelProvider}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- API Base URL -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="API Base URL" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding PanelBaseUrl}" FontSize="12"
                                           Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <!-- API Key 行 -->
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding PanelIsLocal, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding PanelApiKeyLabel}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                         Text="{Binding PanelApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="13"/>
                            </Grid>

                            <!-- Endpoint ID 行（仅豆包显示） -->
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding PanelHasEndpoint, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding PanelEndpointLabel}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                         Text="{Binding PanelEndpointValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="13" ToolTip="如豆包的 ep-XXXXXX 格式"/>
                            </Grid>

                            <!-- Ollama 提示 -->
                            <TextBlock FontSize="12" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding PanelIsLocal, Converter={StaticResource BoolToVis}}"
                                       Text="本地 Ollama 模型无需 API Key，确保 Ollama 服务已在本机启动（默认 http://localhost:11434）"/>

                            <!-- 模型描述 -->
                            <TextBlock Text="{Binding SelectedModelItem.Description}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"
                                       Visibility="{Binding SelectedModelItem.Description, Converter={StaticResource StringToVis}}"/>

                            <!-- 能力状态（有/无） -->
                            <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="6"
                                    Padding="10,8" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 图像识别 -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="🖼" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock Text="图像识别" FontSize="10" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                                        <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="无"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PanelSupportsVision}" Value="True">
                                                            <Setter Property="Text" Value="有"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- 视频识别 -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="🎬" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock Text="视频识别" FontSize="10" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                                        <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="无"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PanelSupportsVideoUnderstanding}" Value="True">
                                                            <Setter Property="Text" Value="有"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- 图像生成 -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="✨" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock Text="图像生成" FontSize="10" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                                        <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="无"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PanelSupportsImageGen}" Value="True">
                                                            <Setter Property="Text" Value="有"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentYellowBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- 视频生成 -->
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <TextBlock Text="🎥" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock Text="视频生成" FontSize="10" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                                        <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="无"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PanelSupportsVideoGen}" Value="True">
                                                            <Setter Property="Text" Value="有"/>
                                                            <Setter Property="Foreground" Value="#FFFF6688"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 连接测试 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="🔌 连接测试" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding TestConnectionCommand}"
                                        IsEnabled="{Binding IsTesting, Converter={StaticResource InvertBool}}"/>
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                           FontSize="12" TextWrapping="Wrap"
                                           Visibility="{Binding TestResultMessage, Converter={StaticResource StringToVis}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TestResultIsSuccess}" Value="False">
                                                    <Setter Property="Foreground" Value="#FFFF6B6B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.Text><Binding Path="TestResultMessage"/></TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── 界面主题 ── -->
                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🎨 界面主题" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⬛ Dark"
                                        Command="{Binding ApplyThemeCommand}" CommandParameter="Dark" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTheme}" Value="Dark">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource BgDarkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="🌊 Ocean"
                                        Command="{Binding ApplyThemeCommand}" CommandParameter="Ocean" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTheme}" Value="Ocean">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource BgDarkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="💚 Matrix"
                                        Command="{Binding ApplyThemeCommand}" CommandParameter="Matrix" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTheme}" Value="Matrix">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource BgDarkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="☀️ Light"
                                        Command="{Binding ApplyThemeCommand}" CommandParameter="Light" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTheme}" Value="Light">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource BgDarkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="🦞 Claw"
                                        Command="{Binding ApplyThemeCommand}" CommandParameter="Claw" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTheme}" Value="Claw">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource BgDarkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── 费用预警 ── -->
                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="💰 费用预警阈值" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="日预算（元）" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                         Text="{Binding DailyBudget}" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="月预算（元）" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                         Text="{Binding MonthlyBudget}" Margin="0,6,0,0"/>
                            </Grid>
                            <CheckBox Content="达到红色预警时自动暂停AI调用" Margin="0,8,0,0"
                                      IsChecked="{Binding AutoPauseOnCritical}"
                                      Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- ── 升级学习 ── -->
                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="🧠 升级学习" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="遍历 RAG 学习笔记库，生成「学习升级总结.md」并更新核心经验库"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"
                                       TextWrapping="Wrap"/>
                            <ProgressBar Value="{Binding LearningProgress}" Maximum="100"
                                         Height="6" Background="{DynamicResource BgDarkBrush}"
                                         Foreground="{DynamicResource AccentGreenBrush}"
                                         Visibility="{Binding IsLearning, Converter={StaticResource BoolToVis}}"
                                         Margin="0,0,0,8"/>
                            <TextBox Text="{Binding LearningOutput}" IsReadOnly="True"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     FontSize="11" Margin="0,0,0,8"
                                     Visibility="{Binding LearningOutput, Converter={StaticResource StringToVis}}"/>
                            <Button Content="▶ 开始升级学习" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding RunLearningUpgradeCommand}"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsLearning, Converter={StaticResource InvertBool}}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
