<UserControl x:Class="ClawBY19.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClawBY19.ViewModels"
             xmlns:chat="clr-namespace:ClawBY19.Services.Chat"
             Background="{DynamicResource BgDarkBrush}">

    <UserControl.Resources>
        <!-- 用户消息气泡 -->
        <DataTemplate x:Key="UserBubble" DataType="{x:Type vm:ChatMessageItem}">
            <Grid Margin="8,4">
                <StackPanel HorizontalAlignment="Right" MaxWidth="600">
                    <Border Background="{DynamicResource UserBubbleBgBrush}" CornerRadius="12,2,12,12"
                            Padding="12,8" Margin="60,0,0,0">
                        <StackPanel>
                            <TextBox Style="{StaticResource BubbleText}"
                                     Text="{Binding Content, Mode=OneWay}"
                                     Foreground="{DynamicResource ChatUserBrush}"/>
                            <!-- 附件缩略图 -->
                            <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,6,0,0"
                                          Visibility="{Binding Attachments.Count, Converter={StaticResource CountToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type chat:AttachmentItem}">
                                        <Border Margin="0,0,4,4" CornerRadius="4"
                                                Background="#22FFFFFF">
                                            <StackPanel>
                                                <Image Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"
                                                       MaxWidth="120" MaxHeight="120" Stretch="UniformToFill"
                                                       ToolTip="{Binding DisplayName}"
                                                       Tag="{Binding Base64Data}"
                                                       MouseRightButtonUp="Image_RightClick">
                                                    <Image.Source>
                                                        <Binding Path="Base64Data">
                                                            <Binding.Converter>
                                                                <StaticResource ResourceKey="Base64ToImage"/>
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </Image.Source>
                                                    <Image.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="复制图片" Click="CopyImage_Click"/>
                                                            <MenuItem Header="复制文件名" Click="CopyImageName_Click"/>
                                                        </ContextMenu>
                                                    </Image.ContextMenu>
                                                </Image>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" Padding="6,4"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding IsImage, Converter={StaticResource InvertBoolToVis}}"
                                                           MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding TimeStr}" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" Margin="0,2,4,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- AI消息气泡 -->
        <DataTemplate x:Key="AssistantBubble" DataType="{x:Type vm:ChatMessageItem}">
            <Grid Margin="8,4">
                <StackPanel HorizontalAlignment="Left" MaxWidth="700">
                    <!-- 顶部：🦞 图标 + 模型名 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="🦞" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ModelUsed}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="2,12,12,12"
                            Padding="12,10" Margin="0,0,60,0">
                        <StackPanel>
                            <Grid>
                                <!-- 思考动画（IsThinking=true 时显示） -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsThinking, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="🦞" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <!-- 循环三态点：...  ..  . -->
                                    <TextBlock x:Name="ThinkDots" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBlueBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Text="...">
                                        <TextBlock.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <ObjectAnimationUsingKeyFrames
                                                            Storyboard.TargetName="ThinkDots"
                                                            Storyboard.TargetProperty="Text"
                                                            Duration="0:0:1.2">
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.0"  Value="..."/>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.4"  Value=".. "/>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.8"  Value=".  "/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </TextBlock.Triggers>
                                    </TextBlock>
                                    <TextBlock Text="思考中" FontSize="12" FontStyle="Italic"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 正文（IsThinking=false 时显示） -->
                                <TextBox Style="{StaticResource BubbleText}"
                                         Text="{Binding Content, Mode=OneWay}"
                                         Foreground="{DynamicResource ChatAssistantBrush}"
                                         Visibility="{Binding IsThinking, Converter={StaticResource InvertBoolToVis}}"/>
                            </Grid>
                            <!-- AI 生成的图片附件 -->
                            <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,6,0,0"
                                          Visibility="{Binding Attachments.Count, Converter={StaticResource CountToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type chat:AttachmentItem}">
                                        <Border Margin="0,0,4,4" CornerRadius="4" Background="#22FFFFFF">
                                            <Image Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"
                                                   MaxWidth="400" MaxHeight="400" Stretch="Uniform"
                                                   ToolTip="{Binding DisplayName}"
                                                   MouseRightButtonUp="Image_RightClick">
                                                <Image.Source>
                                                    <Binding Path="Base64Data">
                                                        <Binding.Converter>
                                                            <StaticResource ResourceKey="Base64ToImage"/>
                                                        </Binding.Converter>
                                                    </Binding>
                                                </Image.Source>
                                                <Image.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="复制图片" Click="CopyImage_Click"/>
                                                        <MenuItem Header="复制文件名" Click="CopyImageName_Click"/>
                                                    </ContextMenu>
                                                </Image.ContextMenu>
                                            </Image>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="4,2,0,0">
                        <TextBlock Text="{Binding TimeStr}" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding CostStr}" FontSize="10"
                                   Foreground="{DynamicResource AccentGreenBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <vm:MessageTemplateSelector x:Key="MsgTemplateSelector"
            UserTemplate="{StaticResource UserBubble}"
            AssistantTemplate="{StaticResource AssistantBubble}"/>
    </UserControl.Resources>

    <!-- 最外层 Grid -->
    <Grid>

        <!-- ── 主聊天界面 ── -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 顶部：模型切换栏 -->
                <RowDefinition Height="*"/>     <!-- 消息列表 -->
                <RowDefinition Height="Auto"/>  <!-- 定时任务确认条 -->
                <RowDefinition Height="Auto"/>  <!-- 状态栏 -->
                <RowDefinition Height="Auto"/>  <!-- 附件预览条 -->
                <RowDefinition Height="Auto"/>  <!-- 输入区 -->
            </Grid.RowDefinitions>

            <!-- ── 顶部：当前模型 + 切换按钮 ── -->
            <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                    Padding="12,8" BorderBrush="{DynamicResource BgCardBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" HorizontalAlignment="Left"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Command="{Binding ToggleModelPickerCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🤖" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding CurrentModelDisplay}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text=" ▾" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectionModeLabel}" FontSize="11" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <!-- 能力徽标 -->
                            <Border Background="#22AAAAFF" CornerRadius="4" Padding="5,2" Margin="8,0,0,0"
                                    Visibility="{Binding CurrentModelHasVision, Converter={StaticResource BoolToVis}}"
                                    ToolTip="支持图像识别">
                                <TextBlock Text="🖼 识图" FontSize="10" Foreground="{DynamicResource AccentBlueBrush}"/>
                            </Border>
                            <Border Background="#2255CC55" CornerRadius="4" Padding="5,2" Margin="4,0,0,0"
                                    Visibility="{Binding CurrentModelHasVideoUnderstanding, Converter={StaticResource BoolToVis}}"
                                    ToolTip="支持视频识别">
                                <TextBlock Text="🎬 识视频" FontSize="10" Foreground="{DynamicResource AccentGreenBrush}"/>
                            </Border>
                            <Border Background="#22FFAA00" CornerRadius="4" Padding="5,2" Margin="4,0,0,0"
                                    Visibility="{Binding CurrentModelHasImageGen, Converter={StaticResource BoolToVis}}"
                                    ToolTip="支持图像生成">
                                <TextBlock Text="✨ 生图" FontSize="10" Foreground="{DynamicResource AccentYellowBrush}"/>
                            </Border>
                            <Border Background="#22FF6688" CornerRadius="4" Padding="5,2" Margin="4,0,0,0"
                                    Visibility="{Binding CurrentModelHasVideoGen, Converter={StaticResource BoolToVis}}"
                                    ToolTip="支持视频生成">
                                <TextBlock Text="🎥 生视频" FontSize="10" Foreground="#FFFF6688"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- 导出按钮 + 下拉菜单 -->
                        <Grid Margin="0,0,6,0">
                            <Button x:Name="ExportBtn" Content="📤 导出" Style="{StaticResource NavButton}"
                                    Command="{Binding ToggleExportMenuCommand}"
                                    Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Popup x:Name="ExportPopup"
                                   IsOpen="{Binding IsExportMenuOpen}"
                                   PlacementTarget="{Binding ElementName=ExportBtn}"
                                   Placement="Bottom" StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8"
                                        BorderBrush="{DynamicResource BgPanelBrush}" BorderThickness="1"
                                        Padding="4" MinWidth="160">
                                    <StackPanel>
                                        <Button Content="📋 复制全部" Style="{StaticResource NavButton}"
                                                Command="{Binding CopyChatTextCommand}"
                                                HorizontalContentAlignment="Left"/>
                                        <Button Content="🌐 导出 HTML" Style="{StaticResource NavButton}"
                                                Command="{Binding ExportHtmlCommand}"
                                                HorizontalContentAlignment="Left"/>
                                        <Button Content="📝 导出 Word" Style="{StaticResource NavButton}"
                                                Command="{Binding ExportWordCommand}"
                                                HorizontalContentAlignment="Left"/>
                                        <Button Content="🖨 打印/PDF" Style="{StaticResource NavButton}"
                                                Command="{Binding ExportPdfCommand}"
                                                HorizontalContentAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button Content="➕ 新会话" Style="{StaticResource NavButton}"
                                Command="{Binding NewSessionCommand}"
                                Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── 模型选择弹出框 ── -->
            <Popup Grid.Row="0" IsOpen="{Binding IsModelPickerOpen}" StaysOpen="False"
                   AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=ModelPickerAnchor}">
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8"
                        BorderBrush="{DynamicResource BgPanelBrush}" BorderThickness="1"
                        MinWidth="320" MaxHeight="480">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PickerModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ModelPickerItem}">
                                    <Button Background="Transparent" BorderThickness="0"
                                            HorizontalContentAlignment="Stretch" Cursor="Hand"
                                            Command="{Binding DataContext.PickModelCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsEnabled}">
                                        <Border Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding FullName}" FontSize="13">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Provider}" FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding CategoryLabel}"
                                                           FontSize="10" Foreground="{DynamicResource AccentBlueBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- Popup 锚点 -->
            <FrameworkElement x:Name="ModelPickerAnchor" Grid.Row="0" Height="0" VerticalAlignment="Bottom"/>

            <!-- ── 消息列表 ── -->
            <ScrollViewer Grid.Row="1" x:Name="MessageScroller"
                          VerticalScrollBarVisibility="Auto" Padding="8">
                <ItemsControl ItemsSource="{Binding Messages}"
                              ItemTemplateSelector="{StaticResource MsgTemplateSelector}"/>
            </ScrollViewer>

            <!-- ── 定时任务确认条 ── -->
            <Border Grid.Row="2" Background="#1A4080" CornerRadius="8" Margin="12,4"
                    Padding="14,10"
                    Visibility="{Binding IsTaskConfirmOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="⏰ 检测到定时任务安排" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBlueBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding PendingTaskDescription}" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                            <Run Text="⏱ Cron："/>
                            <Run Text="{Binding PendingTaskCron}" FontFamily="Consolas"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="✅ 确认创建" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                Command="{Binding ConfirmScheduledTaskCommand}"/>
                        <Button Content="✕ 忽略" Style="{StaticResource NavButton}"
                                Command="{Binding DismissScheduledTaskCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── 状态栏 ── -->
            <Border Grid.Row="3" Background="{DynamicResource BgPanelBrush}" Padding="12,4"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 等待响应时的脉冲动画 logo -->
                    <Border x:Name="PulsingLogo"
                            Visibility="{Binding IsWaitingForResponse, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,8,0" VerticalAlignment="Center">
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PulsingLogo"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1.0" To="0.2" Duration="0:0:0.6"
                                                         AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <TextBlock Text="{Binding CurrentModelEmoji}" FontSize="20" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <Button Content="取消" Style="{StaticResource NavButton}" FontSize="11"
                            Command="{Binding CancelStreamCommand}" Margin="12,0,0,0"
                            Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- ── 附件预览条 ── -->
            <Border Grid.Row="4" Background="{DynamicResource BgPanelBrush}" Padding="12,6"
                    BorderBrush="{DynamicResource BgCardBrush}" BorderThickness="0,1,0,0"
                    Visibility="{Binding Attachments.Count, Converter={StaticResource CountToVis}}">
                <ItemsControl ItemsSource="{Binding Attachments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type chat:AttachmentItem}">
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="6"
                                    Margin="0,0,8,0" Padding="6,4">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 图片缩略图 -->
                                    <Image Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"
                                           Width="40" Height="40" Stretch="UniformToFill"
                                           Margin="0,0,4,0">
                                        <Image.Source>
                                            <Binding Path="Base64Data">
                                                <Binding.Converter>
                                                    <StaticResource ResourceKey="Base64ToImage"/>
                                                </Binding.Converter>
                                            </Binding>
                                        </Image.Source>
                                    </Image>
                                    <!-- 文件图标 -->
                                    <TextBlock Text="📄" FontSize="20"
                                               Visibility="{Binding IsImage, Converter={StaticResource InvertBoolToVis}}"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <!-- 文件名 -->
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" MaxWidth="100"
                                               TextTrimming="CharacterEllipsis"/>
                                    <!-- 删除按钮 -->
                                    <Button Content="✕" Background="Transparent" BorderThickness="0"
                                            FontSize="10" Margin="4,0,0,0"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Command="{Binding DataContext.RemoveAttachmentCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- ── 输入区 ── -->
            <Border Grid.Row="5" Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BgCardBrush}" BorderThickness="0,1,0,0"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>  <!-- 附件按钮 -->
                        <ColumnDefinition Width="*"/>     <!-- 输入框 -->
                        <ColumnDefinition Width="Auto"/>  <!-- 发送按钮 -->
                    </Grid.ColumnDefinitions>

                    <!-- 附件按钮 + 弹出菜单 -->
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Button x:Name="AttachBtn" Content="+"
                                Style="{StaticResource NavButton}" FontSize="20" FontWeight="Light"
                                Click="AttachBtn_Click"
                                ToolTip="上传文件/图片/视频"/>
                        <Popup x:Name="AttachPopup" PlacementTarget="{Binding ElementName=AttachBtn}"
                               Placement="Top" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8"
                                    BorderBrush="{DynamicResource BgPanelBrush}" BorderThickness="1"
                                    Padding="4">
                                <StackPanel>
                                    <Button Content="📄 上传文件" Style="{StaticResource NavButton}"
                                            Command="{Binding AddFileCommand}"
                                            Click="AttachMenuItem_Click"/>
                                    <Button Content="🖼 上传图片" Style="{StaticResource NavButton}"
                                            Command="{Binding AddImageCommand}"
                                            Click="AttachMenuItem_Click"/>
                                    <Button Content="🎬 上传视频" Style="{StaticResource NavButton}"
                                            Command="{Binding AddVideoCommand}"
                                            Click="AttachMenuItem_Click"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <TextBox Grid.Column="1" x:Name="InputBox"
                             Style="{StaticResource DarkTextBox}"
                             Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" MaxLines="6"
                             MinHeight="72" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="InputBox_KeyDown"
                             VerticalAlignment="Stretch"
                             ToolTip="Enter 发送，Shift+Enter 换行，Ctrl+V 粘贴图片"/>

                    <Button Grid.Column="2" Content="发 送" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SendMessageCommand}"
                            IsEnabled="{Binding IsStreaming, Converter={StaticResource InvertBool}}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════ 昵称输入对话框（遮罩层） ══════ -->
        <Grid Visibility="{Binding IsNickNameDialogOpen, Converter={StaticResource BoolToVis}}">
            <Rectangle Fill="#AA000000"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                    Padding="32,28" MinWidth="360" MaxWidth="460">
                <StackPanel>
                    <TextBlock Text="🦞 欢迎使用 ClawBY19！" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBlueBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="给我起个昵称吧，以后每次见面我都会用这个名字叫你 :)"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <TextBlock Text="你的昵称" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource DarkTextBox}" FontSize="15"
                             Text="{Binding PendingNickName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             x:Name="NickNameBox"
                             KeyDown="NickNameBox_KeyDown"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="跳过" Style="{StaticResource NavButton}" Margin="0,0,8,0"
                                Command="{Binding ConfirmNickNameCommand}"/>
                        <Button Content="确认 →" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConfirmNickNameCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════ GitHub 操作确认对话框 ══════ -->
        <Grid Visibility="{Binding IsGitHubConfirmOpen, Converter={StaticResource BoolToVis}}">
            <Rectangle Fill="#AA000000"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                    Padding="32,28" MinWidth="400" MaxWidth="520">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="🐙" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="GitHub 同步确认" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="检测到代码同步操作，是否使用上次执行的仓库？"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <!-- 上次仓库信息 -->
                    <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="仓库：" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding GitHubLastRepo}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBlueBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="账号：" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding GitHubLastAccount}" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✕ 取消" Style="{StaticResource NavButton}" Margin="0,0,8,0"
                                Command="{Binding CancelGitHubOpCommand}"/>
                        <Button Content="换新仓库" Style="{StaticResource NavButton}" Margin="0,0,8,0"
                                Command="{Binding DenyGitHubOpCommand}"/>
                        <Button Content="✅ 是的，就用这个" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConfirmGitHubOpCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════ 云端部署确认对话框 ══════ -->
        <Grid Visibility="{Binding IsCloudConfirmOpen, Converter={StaticResource BoolToVis}}">
            <Rectangle Fill="#AA000000"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                    Padding="32,28" MinWidth="400" MaxWidth="520">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="☁️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="云端部署确认" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="检测到云端部署操作，是否上传到上次执行的平台？"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <!-- 上次平台信息 -->
                    <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="平台：" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding CloudLastPlatform}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBlueBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="地址：" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding CloudLastIp}" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="账号：" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding CloudLastAccount}" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✕ 取消" Style="{StaticResource NavButton}" Margin="0,0,8,0"
                                Command="{Binding CancelCloudOpCommand}"/>
                        <Button Content="换新平台" Style="{StaticResource NavButton}" Margin="0,0,8,0"
                                Command="{Binding DenyCloudOpCommand}"/>
                        <Button Content="✅ 是的，就用这个" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConfirmCloudOpCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════ 凭证输入对话框 ══════ -->
        <Grid Visibility="{Binding IsCredentialInputOpen, Converter={StaticResource BoolToVis}}">
            <Rectangle Fill="#AA000000"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                    Padding="32,28" MinWidth="420" MaxWidth="540">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="🔑" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CredentialDialogTitle}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="请填写执行参数，密码将加密保存供下次使用。"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <!-- 目标名称 -->
                    <TextBlock Text="目标名称（如：我的项目 / AWS生产环境）" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource DarkTextBox}"
                             Text="{Binding CredentialTargetNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12"/>
                    <!-- 目标地址 -->
                    <TextBlock Text="目标地址（仓库 URL 或服务器 IP）" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource DarkTextBox}"
                             Text="{Binding CredentialUrlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12"/>
                    <!-- 账号 -->
                    <TextBlock Text="账号 / 用户名" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource DarkTextBox}"
                             Text="{Binding CredentialAccountInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12"/>
                    <!-- 密码（PasswordBox，code-behind 处理） -->
                    <TextBlock Text="密码 / Token（加密存储，不发送给 AI）" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="CredPwdBox"
                                 Style="{StaticResource DarkPasswordBox}"
                                 Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✕ 取消" Style="{StaticResource NavButton}" Margin="0,0,8,0"
                                Command="{Binding CancelCredentialCommand}"/>
                        <Button Content="确认执行 →" Style="{StaticResource PrimaryButton}"
                                Click="CredSubmitBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════ Git 上传对话框 ══════ -->
        <Grid Visibility="{Binding IsGitUploadOpen, Converter={StaticResource BoolToVis}}">
            <Rectangle Fill="#AA000000"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                    Padding="32,28" MinWidth="480" MaxWidth="600">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="🐙" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Git 代码上传" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="填写 Git 上传参数。AI 将自动生成 .gitignore 过滤编译文件，只上传源代码。"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,18"/>

                    <!-- 本地目录 -->
                    <TextBlock Text="本地源代码目录" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}"
                                 Text="{Binding GitLocalPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="输入本地代码目录路径，例如 D:\MyProject"/>
                        <Button Grid.Column="1" Content="📂" Style="{StaticResource NavButton}"
                                Command="{Binding SelectLocalPathCommand}"
                                Margin="4,0,0,0" ToolTip="浏览选择目录"/>
                    </Grid>

                    <!-- 仓库地址 -->
                    <TextBlock Text="Git 仓库地址" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"
                             Text="{Binding GitRemoteUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="如 https://github.com/用户名/仓库名"/>

                    <!-- 分支名 -->
                    <TextBlock Text="分支名" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"
                             Text="{Binding GitBranch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Token -->
                    <TextBlock Text="Personal Access Token（加密保存，不发送给 AI）" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="GitTokenBox"
                                 Style="{StaticResource DarkPasswordBox}"
                                 Margin="0,0,0,12"/>

                    <!-- Commit Message -->
                    <TextBlock Text="Commit 说明（可选）" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,20"
                             Text="{Binding GitCommitMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="留空则自动生成时间戳提交说明"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✕ 取消" Style="{StaticResource NavButton}" Margin="0,0,8,0"
                                Command="{Binding CancelGitUploadCommand}"/>
                        <Button Content="🚀 开始上传" Style="{StaticResource PrimaryButton}"
                                Click="GitUploadSubmitBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════ 自动测试对话框 ══════ -->
        <Grid Visibility="{Binding IsTestDialogOpen, Converter={StaticResource BoolToVis}}">
            <Rectangle Fill="#AA000000"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                    Padding="32,28" MinWidth="460" MaxWidth="560">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="🧪" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="自动化测试" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="选择测试类型，系统将自动遍历所有功能并生成测试日志。"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- 测试类型选择 -->
                    <TextBlock Text="测试类型" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="🌐 Web 应用（URL）" FontSize="13"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     IsChecked="{Binding TestType, Converter={StaticResource EqualToTrue}, ConverterParameter=Web}"
                                     Margin="0,0,24,0" Click="TestTypeWeb_Click"/>
                        <RadioButton Content="💻 本地 EXE 程序" FontSize="13"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     IsChecked="{Binding TestType, Converter={StaticResource EqualToTrue}, ConverterParameter=Exe}"
                                     Click="TestTypeExe_Click"/>
                    </StackPanel>

                    <!-- 测试目标 -->
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4">
                        <Run Text="{Binding TestType, StringFormat='测试目标（{0} 地址/路径）'}"/>
                    </TextBlock>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}"
                                 Text="{Binding TestTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Web: 如 http://localhost:8080 | EXE: 程序完整路径"/>
                        <Button Grid.Column="1" Content="📂" Style="{StaticResource NavButton}"
                                Command="{Binding SelectExePathCommand}"
                                Margin="4,0,0,0" ToolTip="选择 EXE 文件"
                                Visibility="{Binding TestType, Converter={StaticResource EqualToVis}, ConverterParameter=Exe}"/>
                    </Grid>

                    <!-- Web 登录信息（仅 Web 显示） -->
                    <StackPanel Visibility="{Binding TestType, Converter={StaticResource EqualToVis}, ConverterParameter=Web}">
                        <TextBlock Text="登录 URL（可选，如 /login 或完整 URL）" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"
                                 Text="{Binding TestLoginUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="登录用户名（可选）" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding TestUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="登录密码（可选）" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="TestPwdBox"
                                             Style="{StaticResource DarkPasswordBox}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✕ 取消" Style="{StaticResource NavButton}" Margin="0,0,8,0"
                                Command="{Binding CancelTestDialogCommand}"/>
                        <Button Content="🧪 开始测试" Style="{StaticResource PrimaryButton}"
                                Click="TestSubmitBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
