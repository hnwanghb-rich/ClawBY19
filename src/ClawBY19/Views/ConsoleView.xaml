<UserControl x:Class="ClawBY19.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgDarkBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <!-- 标题 -->
            <TextBlock Text="📊 AI 控制台" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBlueBrush}" Margin="0,0,0,16"/>

            <!-- ── 今日统计卡片行 ── -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 今日花费 -->
                <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}"
                        CornerRadius="8" Padding="14,12" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="今日消耗" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="¥" Foreground="{DynamicResource AccentBlueBrush}" FontSize="18" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding TodayCost, StringFormat=F4}"
                                       Foreground="{DynamicResource AccentBlueBrush}" FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodaySuccessRequests, StringFormat={}{0} 次成功}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding TodayTokens, StringFormat={}{0:N0} Tokens}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- 平均延迟 -->
                <Border Grid.Column="1" Background="{DynamicResource BgCardBrush}"
                        CornerRadius="8" Padding="14,12" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="平均响应" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding AvgLatencyMs, StringFormat={}{0:F0}ms}"
                                   Foreground="{DynamicResource AccentGreenBrush}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SuccessRate, StringFormat=成功率 {0:F0}%}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding TodayRequests, StringFormat=共 {0} 次请求}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- 本月 -->
                <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}"
                        CornerRadius="8" Padding="14,12" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="本月消耗" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding MonthCost, StringFormat=¥{0:F2}}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="{Binding MonthTokens, StringFormat={}{0:N0} Tokens}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding WeekCost, StringFormat=本周 ¥{0:F2}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- 累计 -->
                <Border Grid.Column="3" Background="{DynamicResource BgCardBrush}"
                        CornerRadius="8" Padding="14,12" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="累计消耗" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TotalCost, StringFormat=¥{0:F2}}"
                                   Foreground="{DynamicResource AccentYellowBrush}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── 柱状图 ── -->
            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <!-- Tab切换 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="📊 流量分析" Style="{StaticResource NavButton}" FontSize="13"
                                Command="{Binding ChangePeriodCommand}" CommandParameter="today"
                                Background="{Binding SelectedTabIndex, Converter={StaticResource TabBgConverter}, ConverterParameter=0}"
                                Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabFgConverter}, ConverterParameter=0}"
                                Click="FlowTab_Click" Margin="0,0,8,0"/>
                        <Button Content="💰 费用分析" Style="{StaticResource NavButton}" FontSize="13"
                                Command="{Binding ChangePeriodCommand}" CommandParameter="today"
                                Background="{Binding SelectedTabIndex, Converter={StaticResource TabBgConverter}, ConverterParameter=1}"
                                Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabFgConverter}, ConverterParameter=1}"
                                Click="CostTab_Click"/>
                    </StackPanel>

                    <!-- 时间维度切换 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding ChartTitle}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="当天" Style="{StaticResource NavButton}" FontSize="11"
                                Command="{Binding ChangePeriodCommand}" CommandParameter="today" Margin="2,0"/>
                        <Button Content="本周" Style="{StaticResource NavButton}" FontSize="11"
                                Command="{Binding ChangePeriodCommand}" CommandParameter="week" Margin="2,0"/>
                        <Button Content="本月" Style="{StaticResource NavButton}" FontSize="11"
                                Command="{Binding ChangePeriodCommand}" CommandParameter="month" Margin="2,0"/>
                        <Button Content="今年" Style="{StaticResource NavButton}" FontSize="11"
                                Command="{Binding ChangePeriodCommand}" CommandParameter="year" Margin="2,0"/>
                    </StackPanel>

                    <!-- 模型过滤器 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="模型过滤：" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding SelectedModelFilter, Mode=TwoWay}"
                                  Width="200" FontSize="11"
                                  Background="{DynamicResource BgDarkBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- 图表区域 -->
                    <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="4" Padding="8" Height="200">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Y轴刻度 -->
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding YAxisTicks}" VerticalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid Height="170"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform>
                                                    <TranslateTransform.Y>
                                                        <MultiBinding Converter="{StaticResource YAxisPositionConverter}">
                                                            <Binding Path="."/>
                                                            <Binding Path="DataContext.MaxYValue" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                        </MultiBinding>
                                                    </TranslateTransform.Y>
                                                </TranslateTransform>
                                            </StackPanel.RenderTransform>
                                            <TextBlock Text="{Binding StringFormat={}{0:F0}}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Width="40" TextAlignment="Right" Margin="0,0,4,0"/>
                                            <Rectangle Width="6" Height="1" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.3"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 柱状图 -->
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding ChartData}" Margin="0,0,0,20">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" VerticalAlignment="Bottom"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Bottom"
                                                    Margin="1,0"
                                                    ToolTip="{Binding Tooltip}">
                                            <!-- 柱上数值 -->
                                            <TextBlock Text="{Binding ValueText}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource AccentBlueBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,2"
                                                       FontWeight="SemiBold"/>
                                            <!-- 柱子 -->
                                            <Rectangle Fill="{DynamicResource AccentBlueBrush}"
                                                       VerticalAlignment="Bottom">
                                                <Rectangle.Height>
                                                    <MultiBinding Converter="{StaticResource ChartHeightConverter}">
                                                        <Binding Path="Value"/>
                                                        <Binding Path="DataContext.MaxYValue" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                    </MultiBinding>
                                                </Rectangle.Height>
                                            </Rectangle>
                                            <!-- X轴标签 -->
                                            <TextBlock Text="{Binding Label}" FontSize="9"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                    <TextBlock Text="* 悬停查看详细数据"
                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ── 最近调用记录表格 ── -->
            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="最近调用记录（最新50条）"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,10"/>

                    <!-- 表头 -->
                    <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="时间" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="模型" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="输入T" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="输出T" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="总Tokens" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="费用" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="6" Text="延迟" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="7" Text="状态" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 数据行 -->
                    <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="4" MaxHeight="320">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,5" BorderBrush="{DynamicResource BgPanelBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Model}" FontSize="11"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding InputTokens, StringFormat={}{0:N0}}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding OutputTokens, StringFormat={}{0:N0}}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="{Binding TotalTokens, StringFormat={}{0:N0}}" FontSize="11"
                                                           Foreground="{DynamicResource AccentGreenBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="5" Text="{Binding CostStr}" FontSize="11"
                                                           Foreground="{DynamicResource AccentYellowBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="6" Text="{Binding LatencyStr}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="7" Text="{Binding StatusIcon}" FontSize="12"
                                                           TextAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 刷新按钮 -->
            <Button Content="🔄 刷新数据" Style="{StaticResource PrimaryButton}"
                    Command="{Binding RefreshCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
