<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ Claw 主题（纯黑底，橘红系） ══ -->
    <SolidColorBrush x:Key="BgDarkBrush">#FF0A0A0A</SolidColorBrush>
    <SolidColorBrush x:Key="BgPanelBrush">#FF141414</SolidColorBrush>
    <SolidColorBrush x:Key="BgCardBrush">#FF1E1E1E</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBlueBrush">#FFFF4500</SolidColorBrush>
    <SolidColorBrush x:Key="AccentGreenBrush">#FFFF6B35</SolidColorBrush>
    <SolidColorBrush x:Key="AccentYellowBrush">#FFFF8C42</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimaryBrush">#FFFFA07A</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryBrush">#FFCD8B6A</SolidColorBrush>

    <!-- 聊天消息角色颜色 -->
    <SolidColorBrush x:Key="ChatUserBrush">#FFFFB899</SolidColorBrush>
    <SolidColorBrush x:Key="ChatAssistantBrush">#FFFFA07A</SolidColorBrush>
    <SolidColorBrush x:Key="ChatSystemBrush">#FFCD8B6A</SolidColorBrush>
    <SolidColorBrush x:Key="UserBubbleBgBrush">#FF3D1A0A</SolidColorBrush>

</ResourceDictionary>
