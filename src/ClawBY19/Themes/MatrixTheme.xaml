<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ Matrix 主题（终端绿，黑底绿字） ══ -->
    <SolidColorBrush x:Key="BgDarkBrush">#FF0A0F0A</SolidColorBrush>
    <SolidColorBrush x:Key="BgPanelBrush">#FF0F1A0F</SolidColorBrush>
    <SolidColorBrush x:Key="BgCardBrush">#FF152215</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBlueBrush">#FF00FF41</SolidColorBrush>
    <SolidColorBrush x:Key="AccentGreenBrush">#FF39FF14</SolidColorBrush>
    <SolidColorBrush x:Key="AccentYellowBrush">#FFFFD700</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimaryBrush">#FFA0FFB0</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryBrush">#FF4A8A4A</SolidColorBrush>

    <!-- 聊天消息角色颜色 -->
    <SolidColorBrush x:Key="ChatUserBrush">#FF00FF7F</SolidColorBrush>
    <SolidColorBrush x:Key="ChatAssistantBrush">#FFE0FFE0</SolidColorBrush>
    <SolidColorBrush x:Key="ChatSystemBrush">#FF4A8A4A</SolidColorBrush>
    <SolidColorBrush x:Key="UserBubbleBgBrush">#FF004A00</SolidColorBrush>

</ResourceDictionary>
