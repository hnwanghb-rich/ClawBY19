<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ Dark 主题（默认深黑蓝紫） ══ -->
    <SolidColorBrush x:Key="BgDarkBrush">#FF1E1E2E</SolidColorBrush>
    <SolidColorBrush x:Key="BgPanelBrush">#FF2A2A3E</SolidColorBrush>
    <SolidColorBrush x:Key="BgCardBrush">#FF313244</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBlueBrush">#FF89B4FA</SolidColorBrush>
    <SolidColorBrush x:Key="AccentGreenBrush">#FFA6E3A1</SolidColorBrush>
    <SolidColorBrush x:Key="AccentYellowBrush">#FFFAB387</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimaryBrush">#FFCDD6F4</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryBrush">#FF6C7086</SolidColorBrush>

    <!-- 聊天消息角色颜色 -->
    <SolidColorBrush x:Key="ChatUserBrush">#FF89DCEB</SolidColorBrush>
    <SolidColorBrush x:Key="ChatAssistantBrush">#FFFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ChatSystemBrush">#FF6C7086</SolidColorBrush>
    <SolidColorBrush x:Key="UserBubbleBgBrush">#FF4A4A8A</SolidColorBrush>

</ResourceDictionary>
