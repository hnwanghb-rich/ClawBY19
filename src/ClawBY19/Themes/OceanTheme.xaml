<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ Ocean 主题（深海军蓝 + 青色） ══ -->
    <SolidColorBrush x:Key="BgDarkBrush">#FF0D1B2A</SolidColorBrush>
    <SolidColorBrush x:Key="BgPanelBrush">#FF112233</SolidColorBrush>
    <SolidColorBrush x:Key="BgCardBrush">#FF1A2F44</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBlueBrush">#FF00D4FF</SolidColorBrush>
    <SolidColorBrush x:Key="AccentGreenBrush">#FF00E5CC</SolidColorBrush>
    <SolidColorBrush x:Key="AccentYellowBrush">#FFFFB347</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimaryBrush">#FFE8F4FD</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryBrush">#FF5A8FA8</SolidColorBrush>

    <!-- 聊天消息角色颜色 -->
    <SolidColorBrush x:Key="ChatUserBrush">#FF00BFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ChatAssistantBrush">#FFE8F4FD</SolidColorBrush>
    <SolidColorBrush x:Key="ChatSystemBrush">#FF5A8FA8</SolidColorBrush>
    <SolidColorBrush x:Key="UserBubbleBgBrush">#FF1E4A7A</SolidColorBrush>

</ResourceDictionary>
